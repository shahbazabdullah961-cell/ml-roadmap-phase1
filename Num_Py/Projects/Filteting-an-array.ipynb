   "source": [
    "#Filter an array: extract all values above the mean\n",
    "import numpy as np\n",
    "import random\n",
    "import math\n",
    "array=np.round(np.random.random(15)*1000,0)\n",
    "mean=np.mean(array)\n",
    "mask=array>mean\n",
    "\n",
    "print(mean)\n",
    "print(array[mask])"
   ]
  }
